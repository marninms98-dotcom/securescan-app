    "notes": [
      {
        "id": "n1",
        "t": "2026-11-12T01:24:05Z",
        "end": "2026-11-12T01:24:31Z",
        "text": "Arrived on site. Owner says the washing machine hose let go overnight and the water ran through the laundry and out into the hallway.",
        "source": "voice",
        "audio": "audio/001.m4a",
        "audioOffset": 0,
        "edited": false
      },
      {
        "id": "n2",
        "t": "2026-11-12T01:29:48Z",
        "end": "2026-11-12T01:30:02Z",
        "text": "Hose on the back of the washer has split at the crimp. That's our source, about 350 up on the laundry wall.",
        "source": "voice",
        "audio": "audio/001.m4a",
        "audioOffset": 343.1,
        "edited": false
      },
      {
        "id": "n3",
        "t": "2026-11-12T01:33:20Z",
        "end": "2026-11-12T01:33:41Z",
        "text": "Behind the washer the skirting is 38 and a half, plasterboard 29 at 300 and 17 and a half at 600, back to 11 by 1200.",
        "source": "voice",
        "audio": "audio/001.m4a",
        "audioOffset": 555.0,
        "edited": false
      },
      {
        "id": "n4",
        "t": "2026-11-12T01:36:05Z",
        "end": "2026-11-12T01:36:16Z",
        "text": "Laundry side wall next to the door is wet at the skirting, 24 percent.",
        "source": "voice",
        "audio": "audio/001.m4a",
        "audioOffset": 720.4,
        "edited": false
      },
      {
        "id": "n5",
        "t": "2026-11-12T01:39:40Z",
        "end": "2026-11-12T01:39:58Z",
        "text": "Hallway vinyl is wet up to about here near the linen cupboard, that looks like the edge of the spread.",
        "source": "voice",
        "audio": "audio/001.m4a",
        "audioOffset": 935.2,
        "edited": false
      },
      {
        "id": "n6",
        "t": "2026-11-12T01:42:20Z",
        "end": "2026-11-12T01:42:33Z",
        "text": "Dry control in the bedroom on the same plasterboard, nine and a half.",
        "source": "voice",
        "audio": "audio/001.m4a",
        "audioOffset": 1095.8,
        "edited": false
      },
      {
        "id": "n7",
        "t": "2026-11-12T01:48:10Z",
        "end": "2026-11-12T01:48:36Z",
        "text": "Bedroom front wall, taped the moisture line. About 1500 at the left end coming down to around 900 towards the bed.",
        "source": "voice",
        "audio": "audio/001.m4a",
        "audioOffset": 1445.0,
        "edited": true
      },
      {
        "id": "n8",
        "t": "2026-11-12T01:56:30Z",
        "text": "Owner has photos of the burst hose on her phone, she will email them through.",
